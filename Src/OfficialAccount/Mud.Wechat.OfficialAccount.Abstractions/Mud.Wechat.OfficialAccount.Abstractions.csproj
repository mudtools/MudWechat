<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>微信公众号/服务号 SDK 认证与多应用基座包：接口调用凭据签发接口、令牌管理器（普通/稳定双通道）、多公众号管理、配置面、常量/枚举/异常。对应 Mud.Wechat.Work.Abstractions。</Description>
		<PackageTags>Wechat;OfficialAccount;公众号;服务号;Authentication;TokenManager;MultiApp;MudWechat</PackageTags>
		<!-- MUD005（Query 令牌注入存在 URL 泄露面）：微信公众号官方契约强制令牌走 Query 参数
		（access_token 为 URL 查询参数，官方不支持 Header 注入），无法改用 Header。
		TokenRecoveryOptions.TokenInvalidationDetector 为接口类型属性、不做配置绑定，配置绑定源生成器
		对接口属性报 SYSLIB1100/1101（生成器上报，#pragma 无法抑制），一并项目级静默并注明原因。 -->
		<NoWarn>$(NoWarn);MUD005;SYSLIB1100;SYSLIB1101</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils" Version="3.0.3" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.3" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- 回调契约登记生成器（产品线中立工具，回调接收模块设计方案 v3 §3.4）：按 [MpCallbackContract] 声明
	     发射 MpPayloadContracts.RegisterAll 方法体。**必须挂在本工程**：partial 方法体与 partial 宿主
	     必须同属一个程序集，而公众号载荷 DTO 与契约宿主落 OA.Abstractions（宿主引本包即可定义类型化处理器，
	     零 ASP.NET 依赖）。工具为中立名，不构成对 Work 产品线的横向引用。 -->
	<ItemGroup>
		<ProjectReference Include="..\..\Core\Mud.Wechat.Callback.Generator\Mud.Wechat.Callback.Generator.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\Mud.Wechat.Abstractions\Mud.Wechat.Abstractions.csproj" />
		<ProjectReference Include="..\Mud.Wechat.OfficialAccount.DataModels\Mud.Wechat.OfficialAccount.DataModels.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Wechat.OfficialAccount" />
		<InternalsVisibleTo Include="Mud.Wechat.OfficialAccount.Tests" />
		<!-- 回调载荷/信封的 internal set 由运行时包（读取器/接收器）与测试工程填写（与企微侧 Work.Callback 同款）。 -->
		<InternalsVisibleTo Include="Mud.Wechat.OfficialAccount.Callback" />
		<InternalsVisibleTo Include="Mud.Wechat.OfficialAccount.Callback.Tests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

</Project>
