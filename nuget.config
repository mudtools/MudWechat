<?xml version="1.0" encoding="utf-8"?>
<!-- 本文件只声明官方源（AGENTS.md §8：勿加回本机开发源）。
     上游包在发布到 nuget.org 之前的本地联调方式：
         dotnet restore Mud.Wechat.slnx -p:RestoreAdditionalProjectSources=D:\Repos\MudHttpUtils\artifacts-debug
     或在运行 scripts/verify-build.ps1 前设置同名环境变量 RestoreAdditionalProjectSources。
     版本唯一来源与单一版本约束见守卫 G1（Mud.HttpUtils* 全仓同版本）。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
