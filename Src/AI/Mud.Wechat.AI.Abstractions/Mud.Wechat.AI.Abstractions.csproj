<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 受控 TFM 例外（AB-G8 锁定）：AI 域三包钉 net8.0;net10.0 —— Mud.AI 1.0.2 传递要求
		     M.E.* / System.Text.Json 10.0.12，而 M.E.* 10.x 官方支持面为 net8.0+（net6.0 上 NuGet 发
		     「doesn't support net6.0」告警）。不为一条新线把 30 个既有工程的低 TFM 构建拖到未测试组合。 -->
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<Description>微信生态 AI 共享契约层（跨七线）：工具身份轴 WechatToolPrincipal / 风险词表 WechatToolRiskVocabulary / 会话事实 WechatConversationFacts / 事件装配端口 IContextAssembler。零生态细节；依赖限于中立引擎契约 Mud.AI.Abstractions（ConversationRequest 等回合管线输入类型），不依赖任何线专属包。</Description>
		<PackageTags>Wechat;AI;Abstractions;Agent;Tools;MudWechat</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<!-- 中立引擎契约（钉版，禁浮动；AI-G4 校验全仓单一版本）：
		     事件装配结果 ConversationAssembly 要承载回合管线的统一输入 ConversationRequest，
		     这是本层第一个消费 Mud.AI 契约的类型（原「零 Mud.AI 依赖」的设计预期在 S3 落地，见 git 史）。 -->
		<PackageReference Include="Mud.AI.Abstractions" Version="1.0.2" />

		<!-- 契约守卫与单测直读 internal（若有）；对外公开面即 Description 所列类型。 -->
		<InternalsVisibleTo Include="Mud.Wechat.AI.Tests" />
	</ItemGroup>

</Project>
