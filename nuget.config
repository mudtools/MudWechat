<!-- Mud.HttpUtils 3.0.2（SensitiveUrlKeys 下游登记门面，2026-10-07）尚未发布 nuget.org，
     暂以本地源消费上游产物（D:\Repos\MudHttpUtils\artifacts-debug，定夺一）；
     官方发布后移除 local-upstream 源、恢复只声明官方源（版本唯一来源与单一版本约束见 G1 守卫）。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
