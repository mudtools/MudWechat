<Project>
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
		<!-- 版本口径：内部演进期依次用过 1.0.3 / 1.1.0 / 1.2.0 / 1.3.0 / 1.3.1（明细见 CHANGELOG.md 的 1.0.0 条目），
		     期间从未向 nuget.org 推送过任何 Mud.Wechat.* 包 ⇒ 对外首发把这些积累归一为 1.0.0。
		     此后版本号只增不减，语义见 CHANGELOG.md。 -->
		<Version>1.0.0</Version>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<Copyright>© 2019-2025 Mud Studio Co.,Ltd.</Copyright>
		<Authors>Mud Studio</Authors>
		<Company>Mud Studio</Company>
		<LangVersion>13.0</LangVersion>
	</PropertyGroup>

	<!-- AOT / 裁剪治理（对齐 FeishuV3 verify-build 门禁）：net8.0+ 默认启用裁剪与 AOT 分析，
	AotStrictMode=true（verify-build.ps1 步骤 3 传入）时把 IL*/IL3050 提升为错误。 -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net10.0'">
		<IsAotCompatible Condition="'$(IsAotCompatible)' == ''">true</IsAotCompatible>
		<EnableTrimAnalyzer Condition="'$(EnableTrimAnalyzer)' == ''">true</EnableTrimAnalyzer>
		<EnableAotAnalyzer Condition="'$(EnableAotAnalyzer)' == ''">true</EnableAotAnalyzer>
		<EnableSingleFileAnalyzer Condition="'$(EnableSingleFileAnalyzer)' == ''">true</EnableSingleFileAnalyzer>
		<WarningsAsErrors>$(WarningsAsErrors);AOT001;AOT002;AOT003;AOT004;AOT007</WarningsAsErrors>
		<!-- AOT：ConfigurationBinder.Bind / Configure<T>(IConfiguration) 的反射实现会触发 IL2026/IL3050。
		启用配置绑定源生成器后绑定代码在编译期生成，消除这两类诊断（对齐 FeishuV3 Directory.Build.props）。 -->
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
	</PropertyGroup>
	<PropertyGroup Condition="'$(AotStrictMode)' == 'true' and ('$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net10.0')">
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2050;IL2057;IL2067;IL2070;IL2072;IL2075;IL2080;IL3050</WarningsAsErrors>
	</PropertyGroup>

	<!-- AI 域版本对齐（2026-10-17，AI 功能解决方案 v1.4 S0）：Mud.AI.* 1.0.1（nuget.org，钉版消费）
	     传递要求 M.E.* / System.Text.Json 10.0.12 + Microsoft.Extensions.AI.Abstractions 10.10.1
	     + Microsoft.Agents.AI 1.25.0 —— 直钉版本低于传递要求即触发 NU1603（verify-build 步骤 1 断言 0）。
	     ⚠ 对齐范围刻意<b>只到 net8.0+ 组</b>：M.E.* 10.x 官方支持面为 net8.0+（net6.0 上 NuGet 会发
	     「doesn't support net6.0」告警），故 AI 域三包以受控 TFM 例外钉 net8.0;net10.0（AB-G8 锁定），
	     低 TFM 组（net6.0 / netstandard2.0）维持 8.0.x 不变 —— 避免为一条新线把 30 个既有工程的低 TFM 构建
	     整体拖到「官方未测试」的组合上。 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'or '$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Text.Json" Version="10.0.2" />
	</ItemGroup>
</Project>
