<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 受控 TFM 例外，理由见 Mud.Wechat.Pay.Abstractions.csproj 同名属性组的详注
		     （AesGcm 在 netstandard2.0 不存在；AEAD_AES_256_GCM 为 APIv3 官方强制）。
		     支付线四包（主包/Abstractions/DataModels/Callback）共享同一 TFM 集，保持产品线内
		     一致的可用面与打包口径，避免出现「DataModels 可在 ns2.0 被单独引用、主包却不能」
		     这种半可用的分裂面。 -->
		<TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
		<Description>微信支付 APIv3 SDK 数据模型包（纯 DTO）。Generated/ 目录由 scripts/GenerateJsonContext.ps1（mud-jsonctx）按 [HttpJsonSerializable] 标注生成。</Description>
		<PackageTags>Wechat;Pay;微信支付;Tenpay;APIv3;DTO;DataModels;MudWechat</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils.Attributes" Version="3.0.3" />
		<PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.3" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- 响应基底实现公用层判错契约 IWechatApiResponse（非序列化契约；依赖方向 DataModels → 公用层，公用层为叶子）。 -->
		<ProjectReference Include="..\..\Core\Mud.Wechat.Abstractions\Mud.Wechat.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Wechat.Pay" />
		<InternalsVisibleTo Include="Mud.Wechat.Pay.Abstractions" />
		<InternalsVisibleTo Include="Mud.Wechat.Pay.Callback" />
		<!-- 生成上下文为 internal（对齐 Work.DataModels / OA.DataModels 模式），契约守卫与反序列化测试需直读。 -->
		<InternalsVisibleTo Include="Mud.Wechat.Pay.Tests" />
	</ItemGroup>

</Project>