<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>Mud.Wechat.Work.WebDemo</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- 页面文件随构建产物落位：Demo 也常被直接执行 bin 下的 dll（门禁冒烟），
		     那时内容根是 bin 目录而非工程目录，不复制就会出现「接口全通、页面 404」。 -->
		<Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<!-- Demo 基座：环境变量校验、写操作闸、健康检查端点。 -->
		<ProjectReference Include="..\Mud.Wechat.Demo.Shared\Mud.Wechat.Demo.Shared.csproj" />
		<PackageReference Include="Mud.Wechat.Work" Version="$(MudWechatPackageVersion)" />
	</ItemGroup>

</Project>
