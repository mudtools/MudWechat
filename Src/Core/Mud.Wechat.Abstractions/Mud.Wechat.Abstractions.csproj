<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Mud.Wechat 跨产品线公用横切层：响应判错契约、AppKey 形状校验、域名与 SSRF 白名单常量、配置基座、令牌持久化端口、errcode 令牌失效判定组合器。企业微信 / 公众号等产品线共同引用，本层零产品线依赖。</Description>
		<PackageTags>Wechat;SDK;MudWechat;Abstractions;企业微信;公众号</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils" Version="3.0.3" />
	</ItemGroup>

	<ItemGroup>
		<!-- 收紧的 internals 面：公用层成员（WechatCustomBaseUrlRegistry / WechatTokenRouting 等）仅供本仓产品线与测试直读，
		     不进入对外契约（对齐 Work.Abstractions 的既有形态）。 -->
		<InternalsVisibleTo Include="Mud.Wechat.Work.Abstractions" />
		<InternalsVisibleTo Include="Mud.Wechat.Work" />
		<InternalsVisibleTo Include="Mud.Wechat.Work.Callback" />
		<InternalsVisibleTo Include="Mud.Wechat.OfficialAccount.Abstractions" />
		<InternalsVisibleTo Include="Mud.Wechat.OfficialAccount" />
		<!-- 回调协议与安全内核（Callback/ 子域）的 internal 类型（XML 源缓存/投影器）供两条产品线的运行时包复用。 -->
		<InternalsVisibleTo Include="Mud.Wechat.OfficialAccount.Callback" />
		<InternalsVisibleTo Include="Mud.Wechat.OfficialAccount.Callback.Tests" />
		<InternalsVisibleTo Include="Mud.Wechat.Redis" />
		<InternalsVisibleTo Include="Mud.Wechat.Abstractions.Tests" />
		<InternalsVisibleTo Include="Mud.Wechat.Work.Tests" />
		<InternalsVisibleTo Include="Mud.Wechat.Work.Abstractions.Tests" />
		<InternalsVisibleTo Include="Mud.Wechat.OfficialAccount.Tests" />
		<!-- 微信小程序产品线（设计方案 v2 §3.2）：令牌与多应用基座复用 OfficialAccount，
		     但响应判错契约、配置基座、令牌存储端口与回调内核仍须直读公用层 internal 面。 -->
		<InternalsVisibleTo Include="Mud.Wechat.MiniProgram" />
		<InternalsVisibleTo Include="Mud.Wechat.MiniProgram.Abstractions" />
		<InternalsVisibleTo Include="Mud.Wechat.MiniProgram.Tests" />
		<!-- 微信支付产品线（设计方案 v2 §2）：支付回调复用 IWechatCallbackReplayGuard 与 WechatCallbackFailureKind 语义。 -->
		<InternalsVisibleTo Include="Mud.Wechat.Pay" />
		<InternalsVisibleTo Include="Mud.Wechat.Pay.Abstractions" />
		<InternalsVisibleTo Include="Mud.Wechat.Pay.Callback" />
		<InternalsVisibleTo Include="Mud.Wechat.Pay.Tests" />
		<InternalsVisibleTo Include="Mud.Wechat.Pay.Callback.Tests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

</Project>
