<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>微信公众号/服务号 SDK 回调接收包：URL 验证（GET echostr 回显）、消息推送（明文/兼容/安全三模式）、双验签（GET signature / POST msg_signature）、appid 校验、抗重放指纹、事件分发（类型化处理器 + 拦截器）与被动回复（加密 XML 回写）的 HTTP 中间件与多应用路由。</Description>
		<PackageTags>Wechat;OfficialAccount;公众号;服务号;Callback;Webhook;Middleware;MpCallback;MudWechat</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Mud.Wechat.OfficialAccount.Abstractions\Mud.Wechat.OfficialAccount.Abstractions.csproj" />
	</ItemGroup>

	<!-- 说明（v3 方案 §3.4/E9）：契约登记生成器挂在 OA.Abstractions（partial 方法体与宿主必须同程序集），
	     本工程**不**引用生成器 —— 否则生成器会在本程序集发射「无宿主」的 partial 方法实现（CS0759）。 -->

	<!-- 回调处理器契约分析器（中立工具，档位表驱动）：校验 SupportedEventType ↔ 载荷契约（MUDCB002~005），
	     公众号档位已并入同一分析器（元数据名/键常量类/注册方法名由 Profiles 表声明）。
	     仅诊断、不发射 ⇒ 允许随包下发（analyzers/dotnet/cs）；<b>本工程本身照常产出 nupkg</b>（内嵌该分析器）。 -->
	<ItemGroup>
		<ProjectReference Include="..\..\Core\Mud.Wechat.Callback.Analyzers\Mud.Wechat.Callback.Analyzers.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<!-- v3 方案 D2：ASP.NET 依赖只存在于运行时 Callback 包（叶层与 Abstractions 保持零 ASP.NET）。
	     netstandard2.0 走 2.3.9 包；net6.0+ 走 FrameworkReference（对齐 Work.Callback）。 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.9" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- 抗重放时间窗与响应常量（internal）供测试断言边界。 -->
		<InternalsVisibleTo Include="Mud.Wechat.OfficialAccount.Callback.Tests" />
	</ItemGroup>

	<!-- 随包下发分析器资产（不新增 nupkg）：与 Work.Callback 同款（同一 DLL 两份拷贝，两包互不引用）。
	     只挑本仓分析器 DLL；Mud.HttpUtils.Generator（独立包）与发射型 Callback.Generator 不内嵌。 -->
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)..\Src\Mud.Wechat.Callback.Analyzers\bin\$(Configuration)\netstandard2.0\Mud.Wechat.Callback.Analyzers.dll"
		      Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

</Project>
