<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 受控 TFM 例外：与开放平台线 Abstractions / 主包同款（net6.0+，无 ns2.0——组件
		     AddMudHttpClient / HttpClientFactoryEnhancedClient 的最小面；本线无历史兼容包袱）。
		     四包（主包/Abstractions/DataModels/未来 Callback）共享同一 TFM 集，保持产品线内
		     一致的可用面与打包口径。 -->
		<TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
		<Description>微信开放平台「第三方平台」SDK 数据模型包（纯 DTO）。Generated/ 目录由 scripts/GenerateJsonContext.ps1（mud-jsonctx）按 [HttpJsonSerializable] 标注生成。</Description>
		<PackageTags>Wechat;OpenPlatform;开放平台;第三方平台;component;DTO;DataModels;MudWechat</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils.Attributes" Version="3.0.3" />
		<PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.3" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- 响应基底实现公用层判错契约 IWechatApiResponse（非序列化契约；依赖方向 DataModels → 公用层，公用层为叶子）。 -->
		<ProjectReference Include="..\..\Core\Mud.Wechat.Abstractions\Mud.Wechat.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Wechat.OpenPlatform" />
		<InternalsVisibleTo Include="Mud.Wechat.OpenPlatform.Abstractions" />
		<!-- 生成上下文为 internal（对齐 Work.DataModels / OA.DataModels / Pay.DataModels 模式），契约守卫与反序列化测试需直读。 -->
		<InternalsVisibleTo Include="Mud.Wechat.OpenPlatform.Tests" />
	</ItemGroup>

</Project>
