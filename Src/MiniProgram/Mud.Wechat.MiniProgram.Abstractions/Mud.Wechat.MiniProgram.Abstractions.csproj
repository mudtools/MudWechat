<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>微信小程序 SDK 抽象包：配置面、常量/枚举/异常、官方错误码。小程序与公众号同属微信公众平台，令牌与多应用基座直接复用 Mud.Wechat.OfficialAccount.Abstractions（本包不重复实现令牌管理器）。</Description>
		<PackageTags>Wechat;MiniProgram;小程序;Enums;Exceptions;Configuration;MudWechat</PackageTags>
		<!-- MUD005（Query 令牌注入存在 URL 泄露面）：微信公众平台官方契约强制令牌走 Query 参数
		     （access_token 为 URL 查询参数，官方不支持 Header 注入），无法改用 Header。
		     TokenRecoveryOptions.TokenInvalidationDetector 为接口类型属性、不做配置绑定，配置绑定源生成器
		     对接口属性报 SYSLIB1100/1101（生成器上报，#pragma 无法抑制），一并项目级静默并注明原因。 -->
		<NoWarn>$(NoWarn);MUD005;SYSLIB1100;SYSLIB1101</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils" Version="3.0.3" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.3" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\Mud.Wechat.Abstractions\Mud.Wechat.Abstractions.csproj" />
		<ProjectReference Include="..\Mud.Wechat.MiniProgram.DataModels\Mud.Wechat.MiniProgram.DataModels.csproj" />
		<!-- 令牌与多应用基座复用（只引 Abstractions，不引公众号 DTO 与回调，见设计方案 §3.2）。
		     不复制 MpAppManager / MpTokenManagerRegistry：后者为 internal sealed 单槽，
		     新增独立令牌类型会 Resolve → null，导致 errcode 令牌自愈静默失效。 -->
		<ProjectReference Include="..\..\OfficialAccount\Mud.Wechat.OfficialAccount.Abstractions\Mud.Wechat.OfficialAccount.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Wechat.MiniProgram" />
		<InternalsVisibleTo Include="Mud.Wechat.MiniProgram.Tests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

</Project>