<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<DefineConstants>$(DefineConstants);CHANNELS_CALLBACK_TYPED_PAYLOAD</DefineConstants>
		<Description>微信小店/视频号（channels 生态）SDK 回调接收包：URL 验证（GET echostr 回显）、msg_signature 验签、AES 解密（官方强制 JSON + 安全模式）、AppId 校验、抗重放指纹、事件分发（信封级 + 类型化处理器与拦截器，net8+ 类型化通道）的 HTTP 中间件与多应用路由；42 个官方回调事件键经 [ChannelsCallbackContract] 声明式登记。</Description>
		<PackageTags>Wechat;Channels;微信小店;视频号;Callback;Webhook;Middleware;MudWechat</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Mud.Wechat.Channels\Mud.Wechat.Channels.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\Mud.Wechat.Callback.Analyzers\Mud.Wechat.Callback.Analyzers.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.9" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Wechat.Channels.Callback.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)..\..\..\Src\Core\Mud.Wechat.Callback.Analyzers\bin\$(Configuration)\netstandard2.0\Mud.Wechat.Callback.Analyzers.dll"
		      Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

</Project>