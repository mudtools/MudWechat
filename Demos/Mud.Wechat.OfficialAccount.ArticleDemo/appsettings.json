{
  // 公众号文章管理 Demo（DM-14）的设置面。本文件受版本控制 ⇒ 只放模板值与非机密项。
  // 生效优先级（.NET 配置链固有顺序，不要手工往链尾插源，那会盖掉环境变量与命令行）：
  //   appsettings.json < appsettings.Development.json（本机真值，已被 .gitignore 忽略）
  //   < User Secrets < 环境变量（MUDWECHAT_DEMO_* 前缀）< 命令行参数
  // 留空或写成 <占位符> 都等同于「未配置」：启动时一次性列出缺失项，绝不把模板值发给微信。
  "WechatDemo": {
    "AppId": "<你的公众号 AppId>",
    "AppSecret": "<你的公众号 AppSecret>",

    // 留空 = {AppContext.BaseDirectory}/app_data/article-demo.db（随 **/bin/ 被 gitignore）。
    // 改到别处前请读 README §10：库内明文存文章正文，不得放共享目录、不得提交仓库。
    "DbPath": ""
  }
}
