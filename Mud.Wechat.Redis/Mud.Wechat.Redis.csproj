<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>企业微信 SDK Redis 分布式存储扩展包：令牌持久层（含批量删除）、企业授权仓储、套件票据仓储与回调抗重放守卫的 Redis 实现，适用于多实例部署，支持 Native AOT 发布（net8.0+）。对应 Mud.Feishu.Redis。</Description>
		<PackageTags>Wechat;WeChatWork;企业微信;Redis;Distributed;TokenStore;MultiInstance;MudWechat</PackageTags>
		<!-- StackExchange.Redis 3.3.0 及本项目为其提升的 M.E.* 10.x 依赖（见下方 Update）只声明 net8/net10/netstandard2.0
		目标，在 net6.0 下回落 netstandard2.0 资产（net6 完整实现 ns2.0 API 面，功能完备），产生「未测试 TFM」提示性警告。
		逐条核实为 NuGet targets 咨询性提示而非诊断，项目内显式抑制避免污染门禁输出。 -->
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net8.0'">
		<!-- 10.0.9：对齐 Mud.HttpUtils.Client 传递下限（10.0.5 会触发 NU1605 降级错误）。 -->
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.9" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net6.0'">
		<!-- StackExchange.Redis 3.3.0 的 netstandard2.0 组要求 Logging.Abstractions >= 10.0.5，
		根 props 在低 TFM 钉 8.0.3 ⇒ NU1605 降级错误。项目内 Update 提升到 10.0.9
		（两者 nuspec 均支持 netstandard2.0；不复刻飞书根 props 全局压制 NU1605 的做法）。
		Logging.Abstractions 10.x 传递要求 DI.Abstractions >= 10.0.9，同批对齐。 -->
		<PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
		<PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
	</ItemGroup>

	<ItemGroup>
		<!-- 锁定 3.3.0（与 Mud.Feishu.Redis 同版本，AOT strict 兼容性已被其构建验证）。 -->
		<PackageReference Include="StackExchange.Redis" Version="3.3.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- 单依赖（RD11）：四个存储端口契约（含重放守卫接口）同域于 Abstractions。 -->
		<ProjectReference Include="..\Mud.Wechat.Work.Abstractions\Mud.Wechat.Work.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Wechat.Redis.Tests" />
	</ItemGroup>

</Project>
