<?xml version="1.0" encoding="utf-8"?>
<!-- Mud.HttpUtils 正式版 2.0.9 已上架 nuget.org，本地开发包源曾移除（详细设计 §19 / Mud.HttpUtils 改造文档 Phase C）。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- 本地组件开发（未发布）：Mud.HttpUtils 3.0.0 携带 BC-27（移除 UseApp/UseDefaultApp/BeginScope(string)）。
         官方包发布后应移除本源，并把 PackageReference 指回 nuget.org 版本。 -->
    <add key="mudhttputils-local" value="D:\Repos\MudHttpUtils\artifacts" />
  </packageSources>
</configuration>
