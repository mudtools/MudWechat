<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
		<Description>微信开放平台「第三方平台」（component）SDK 主包：component_access_token 的按需刷新、缓存与并发单飞，以及组件化装配（AddOpenPlatform）。**独立产品线**：不引用公众号/小程序线，令牌域严格分离。</Description>
		<PackageTags>Wechat;OpenPlatform;开放平台;第三方平台;component;MudWechat</PackageTags>
		<!-- F6(b) 一等豁免（组件 3.0.5+）：本线令牌（component_access_token / 授权方令牌）经 Query 注入是
		     微信官方契约（MUD005 默认仍报，此处显式声明豁免；其它各线同款开关，见各 csproj）。 -->
		<MudHttpSuppressQueryTokenInjection>true</MudHttpSuppressQueryTokenInjection>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils" Version="3.0.8" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.8" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\Mud.Wechat.Abstractions\Mud.Wechat.Abstractions.csproj" />
		<ProjectReference Include="..\Mud.Wechat.OpenPlatform.Abstractions\Mud.Wechat.OpenPlatform.Abstractions.csproj" />
		<ProjectReference Include="..\Mud.Wechat.OpenPlatform.DataModels\Mud.Wechat.OpenPlatform.DataModels.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Wechat.OpenPlatform.Tests" />
	</ItemGroup>


</Project>