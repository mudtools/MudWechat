<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>Mud.Wechat.MiniProgram.Demo</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Demo 基座：环境变量校验、写操作闸、健康检查端点。 -->
		<ProjectReference Include="..\Mud.Wechat.Demo.Shared\Mud.Wechat.Demo.Shared.csproj" />
		<!-- 小程序主包传递引用 OfficialAccount.Abstractions（令牌与多应用基座复用，AddMpApp 即在彼处）
		     ⇒ 本工程不直引公众号包：小程序线没有回调面，也不消费公众号 DTO（设计方案 §3.5 硬边界）。 -->
		<PackageReference Include="Mud.Wechat.MiniProgram" Version="$(MudWechatPackageVersion)" />
	</ItemGroup>

</Project>
