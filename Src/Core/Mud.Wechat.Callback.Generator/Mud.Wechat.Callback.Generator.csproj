<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0</TargetFrameworks>
		<Description>Mud.Wechat 回调契约登记生成器（产品线中立工具）：按档位分别扫描企微 [WechatCallbackContract]（事件键 + 族前置 + 开放面）与公众号 [MpCallbackContract]（事件键），编译期发射各自登记宿主的 RegisterAll 方法体。以 OutputItemType=Analyzer 被两条产品线引用，不打包（IsPackable=false），不引用任何产品线程序集。</Description>
		<PackageTags>Mud Wechat Roslyn SourceGenerator Analyzer Callback</PackageTags>
		<Product>Mud.Wechat Callback Contract Registration Generator</Product>
		<IsPackable>false</IsPackable>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IncludeBuildOutput>false</IncludeBuildOutput>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Remove="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Remove="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Remove="Microsoft.Extensions.Configuration.Binder" />
		<PackageReference Remove="System.Text.Json" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
	</ItemGroup>

</Project>
