# 本目录接口（Auth 域 code2Session）为「无令牌端点」既存例外：官方以 js_code 一次性凭据换取 openid/session_key，
# 与任何令牌链路均无关，补 [Token] 会让生成器注入本不该存在的令牌参数。
# 以目录级 severity 豁免（Roslyn 标准通道）替代逐文件 #pragma。
# 3.0.9 起 HTTPCLIENT018 由分析器上报：标准 severity 与 .editorconfig 键
# mud_suppress_token_manager_key_inference 两条通道均可达，本文件保留 severity 以与同目录诊断统一。
# 不可改用 [Token(Justification)] 消警 —— 该写法令生成器按默认令牌类型注入 access_token 参数，
# 与 code2Session「无令牌端点」契约冲突。
[*.cs]
dotnet_diagnostic.HTTPCLIENT018.severity = none
