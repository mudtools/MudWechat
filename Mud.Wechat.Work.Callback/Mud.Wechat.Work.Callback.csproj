<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>企业微信 SDK 回调接收包：URL 验证（GET echostr 回显）、suite_ticket / 授权事件推送与通讯录变更、异步任务完成通知的验签、AES 解密、事件分发（类型化处理器 + 拦截器）与多应用 HTTP 中间件。对应 Mud.Feishu.Webhook + EventCallback 职能。</Description>
		<PackageTags>Wechat;WeChatWork;企业微信;Callback;Webhook;suite_ticket;Middleware;MudWechat</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Mud.Wechat.Work.Abstractions\Mud.Wechat.Work.Abstractions.csproj" />
		<ProjectReference Include="..\Mud.Wechat.Work.DataModels\Mud.Wechat.Work.DataModels.csproj" />
	</ItemGroup>

	<!-- v1 方案 D1（对齐 Mud.Feishu.Webhook）：netstandard2.0 保留旧包；net6.0+ 使用 FrameworkReference -->
	<!-- 载荷字段映射生成器：为 [PayloadContract] 载荷类生成 PayloadFieldMap 映射表。
	     注意 Abstractions 中的本包引用带 PrivateAssets="all"，**不会**流向本工程，
	     故此处必须显式引用（否则本工程的载荷类无生成物 ⇒ PayloadFieldMap 成员缺失）。 -->
	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.1" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- 契约登记生成器（本仓侧）：依据 [WechatCallbackContract] 特性发射 OfficialPayloadContracts.RegisterAll
	     方法体。仅本工程消费（PrivateAssets 不流向主包）；工程 IsPackable=false，不进发布链的「恰 5 nupkg」。 -->
	<ItemGroup>
		<ProjectReference Include="..\Mud.Wechat.Work.Callback.Generator\Mud.Wechat.Work.Callback.Generator.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<!-- v1 方案 D1（对齐 Mud.Feishu.Webhook）：netstandard2.0 保留旧包；net6.0+ 使用 FrameworkReference -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.9" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- 抗重放时间窗常量（ReplayWindowSeconds）为 internal，供测试断言边界。 -->
		<InternalsVisibleTo Include="Mud.Wechat.Work.Callback.Tests" />
	</ItemGroup>

</Project>
