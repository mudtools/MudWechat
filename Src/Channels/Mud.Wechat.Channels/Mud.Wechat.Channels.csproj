<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>微信小店/视频号（channels 生态）SDK：配置面 ChannelsAppConfig、令牌类型/管理器（Wechat.Channels.AccessToken，双通道 token/stable_token）、多应用基座、异常与错误码、回调信封与载荷契约、27 个业务域官方 DTO（AOT 源生成 JsonContext）、业务声明式客户端（商品/订单/售后/物流/资金/营销/联盟/会员/直播留资/橱窗/团购核销等）、模块注册器。一线一入口包（2026-10 包合并：原 Mud.Wechat.Channels.Abstractions / Mud.Wechat.Channels.DataModels 并入本包，命名空间不变；收推送另引 Mud.Wechat.Channels.Callback）。小店 AppID 与公众号/小程序 AppID 不互通，令牌域独立（设计方案 v1 §3.2）。</Description>
		<PackageTags>Wechat;Channels;微信小店;视频号;SDK;Authentication;TokenManager;MultiApp;DTO;Configuration;MudWechat</PackageTags>
		<MudHttpSuppressQueryTokenInjection>true</MudHttpSuppressQueryTokenInjection>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils" Version="3.0.9" />
		<PackageReference Include="Mud.HttpUtils.Attributes" Version="3.0.9" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.9" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\Mud.Wechat.Callback.Generator\Mud.Wechat.Callback.Generator.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\Mud.Wechat.Abstractions\Mud.Wechat.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Wechat.Channels.Tests" />
		<InternalsVisibleTo Include="Mud.Wechat.Channels.Callback" />
		<InternalsVisibleTo Include="Mud.Wechat.Channels.Callback.Tests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

</Project>
