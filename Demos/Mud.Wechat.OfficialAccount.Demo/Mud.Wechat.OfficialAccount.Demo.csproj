<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>Mud.Wechat.OfficialAccount.Demo</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- 页面随构建产物落位：门禁冒烟会直接执行 bin 下的 dll，此时内容根是 bin 目录。 -->
		<Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<!-- Demo 基座：环境变量校验、写操作闸、健康检查端点。 -->
		<ProjectReference Include="..\Mud.Wechat.Demo.Shared\Mud.Wechat.Demo.Shared.csproj" />
		<PackageReference Include="Mud.Wechat.OfficialAccount" Version="$(MudWechatPackageVersion)" />
		<!-- 回调包传递引用 Abstractions（AddMpApp 在 Abstractions，主包已直引，两者并存无歧义）；
		     回调处理器契约分析器（MUDCB002~005）随该包 analyzers/dotnet/cs 下发，无需单独引用。 -->
		<PackageReference Include="Mud.Wechat.OfficialAccount.Callback" Version="$(MudWechatPackageVersion)" />
	</ItemGroup>

</Project>
