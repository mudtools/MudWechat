		<PackageTags>Wechat;WeChatWork;企业微信;DTO;DataModels;MudWechat</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils.Generator" Version="2.0.9" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Wechat.Work" />
		<InternalsVisibleTo Include="Mud.Wechat.Work.Abstractions" />
		<InternalsVisibleTo Include="Mud.Wechat.Work.Callback" />
	</ItemGroup>

</Project>
