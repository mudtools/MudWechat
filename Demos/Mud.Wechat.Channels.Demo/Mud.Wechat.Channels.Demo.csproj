<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>Mud.Wechat.Channels.Demo</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Demo 基座：环境变量校验、写操作闸、健康检查端点、业务异常映射闸。 -->
		<ProjectReference Include="..\Mud.Wechat.Demo.Shared\Mud.Wechat.Demo.Shared.csproj" />
		<!-- 小店主包：令牌底座（AddChannelsApp，在 Abstractions、经主包传递可见）+ 29 域声明式客户端。 -->
		<PackageReference Include="Mud.Wechat.Channels" Version="$(MudWechatPackageVersion)" />
		<!-- 回调包：JSON 安全模式接收链（GET echostr 验证 + POST 接收分发）与中间件。 -->
		<PackageReference Include="Mud.Wechat.Channels.Callback" Version="$(MudWechatPackageVersion)" />
		<!-- Mud.Wechat.Callback.Analyzers 随上述回调包 analyzers/dotnet/cs 一并下发；
		     其档位表（WechatCallbackHandlerAnalyzer.Profiles）只有企业微信与公众号两档，小店档位缺失
		     ⇒ MUDCB002~005 对本工程静默空跑（0 诊断、无报错），不代表接线受过编译期校验。
		     补齐档位属 Src 侧改动（须同批动守卫 CB-L1f），不在 Demo 范围。 -->
	</ItemGroup>

</Project>
