<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>Mud.Wechat.Work.OrgApprovalDemo</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- 前端产物随构建落位：门禁冒烟直接执行 bin 下的 dll，此时内容根是 bin 目录。 -->
		<Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<!-- Demo 基座：环境变量校验、写操作闸、健康检查端点、业务异常 → 502 映射闸。 -->
		<ProjectReference Include="..\Mud.Wechat.Demo.Shared\Mud.Wechat.Demo.Shared.csproj" />
		<!-- 企微主包：多应用底座 + 通讯录（Contact）与审批（Approval）两个模块。 -->
		<ProjectReference Include="..\..\Src\Work\Mud.Wechat.Work\Mud.Wechat.Work.csproj" />
		<!-- 回调接收链路（验签 / AES 解密 / 事件分发 / 类型化处理器）。 -->
		<ProjectReference Include="..\..\Src\Work\Mud.Wechat.Work.Callback\Mud.Wechat.Work.Callback.csproj" />
		<!-- 回调处理器契约分析器（狗粮）：本工程 8 个 handler 接入编译期校验，0 诊断为预期。 -->
		<ProjectReference Include="..\..\Src\Core\Mud.Wechat.Callback.Analyzers\Mud.Wechat.Callback.Analyzers.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- 本地台账层（方案 §0 / §5）：FreeSql + SQLite。Demos 已关 AOT/Trim，FreeSql 的
		     反射/表达式面可用；SDK 源工程不得引 FreeSql（AOT 红线），持久层只在 Demo 内。 -->
		<PackageReference Include="FreeSql.Provider.Sqlite" Version="3.5.311" />
	</ItemGroup>

</Project>
