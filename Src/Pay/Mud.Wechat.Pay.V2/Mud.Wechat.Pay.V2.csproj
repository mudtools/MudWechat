<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- APIv2 线 TFM 与支付 v3 线保持一致（net6/8/10，不含 netstandard2.0）。 -->
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <EnableTrimAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableTrimAnalyzer>
    <EnableAotAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableSingleFileAnalyzer>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <RootNamespace>Mud.Wechat.Pay.V2</RootNamespace>
    <AssemblyName>Mud.Wechat.Pay.V2</AssemblyName>
    <Description>Mud.Wechat Pay APIv2 SDK - WeChat Pay APIv2 endpoints with XML serialization and MD5/HMAC-SHA256 signing</Description>
    <PackageTags>wechat;pay;apiv2;sdk</PackageTags>
  </PropertyGroup>

  <!-- 签名判定器、证书通道与收发器一律 internal（公开面只有接口与 DTO），
       契约守卫须直读它们才能锁「workwx_sign 白名单 + 双签顺序」这类不外露的口径。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Mud.Wechat.Pay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mud.HttpUtils" Version="3.0.8" />
    <PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.8" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mud.Wechat.Pay.V2.DataModels\Mud.Wechat.Pay.V2.DataModels.csproj" />
    <ProjectReference Include="..\Mud.Wechat.Pay.Abstractions\Mud.Wechat.Pay.Abstractions.csproj" />
  </ItemGroup>

</Project>
