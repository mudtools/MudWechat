[xUnit.net 00:00:00.28]       using System.Xml;&#xD;
[xUnit.net 00:00:00.28]       using System.Xml.Linq;&#xD;
[xUnit.net 00:00:00.28]       using Mud.Wechat.Abstractions.Callback;&#xD;
[xUnit.net 00:00:00.28]       using Mud.Wechat.OfficialAccount.Abstractions.Callback;&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]       namespace Mud.Wechat.OfficialAccount.Callback;&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]       /// &lt;summary&gt;&#xD;
[xUnit.net 00:00:00.28]       /// 公众号回调接收器：URL 验证（GET 回显）与消息推送（三模式 + 双验签 + appid 校验 + 抗重放指纹）。&#xD;
[xUnit.net 00:00:00.28]       /// &lt;/summary&gt;&#xD;
[xUnit.net 00:00:00.28]       /// &lt;remarks&gt;&#xD;
[xUnit.net 00:00:00.28]       /// &lt;para&gt;&#xD;
[xUnit.net 00:00:00.28]       /// &lt;b&gt;双验签（官方明确要求）&lt;/b&gt;：GET 用 3 参 &lt;c&gt;signature&lt;/c&gt;（&lt;c&gt;sort(token,timestamp,nonce)&lt;/c&gt;，&lt;b&gt;不含&lt;/b&gt; echostr）；&#xD;
[xUnit.net 00:00:00.28]       /// POST 用 4 参 &lt;c&gt;msg_signature&lt;/c&gt;（含包体内 &lt;c&gt;Encrypt&lt;/c&gt;）。官方原文警告「不要使用 signature 验证！」⇒&#xD;
[xUnit.net 00:00:00.28]       /// POST 路径**禁止**回落到 &lt;c&gt;signature&lt;/c&gt;（守卫 CB-MP-2 + 反例用例）。&#xD;
[xUnit.net 00:00:00.28]       /// &lt;/para&gt;&#xD;
[xUnit.net 00:00:00.28]       /// &lt;para&gt;&#xD;
[xUnit.net 00:00:00.28]       /// &lt;b&gt;三模式&lt;/b&gt;：安全模式仅收密文（明文 403）；兼容模式按&lt;b&gt;请求实际形态&lt;/b&gt;分支；明文模式仅收明文。&#xD;
[xUnit.net 00:00:00.28]       /// &lt;/para&gt;&#xD;
[xUnit.net 00:00:00.28]       /// &lt;para&gt;&#xD;
[xUnit.net 00:00:00.28]       /// &lt;b&gt;抗重放&lt;/b&gt;：指纹闸在「解密 + appid 校验成功」之后、事件返回之前消费（解密失败不消耗指纹 ⇒ 官方重试可重入）；&#xD;
[xUnit.net 00:00:00.28]       /// GET 回显只过时效闸、&lt;b&gt;不消费指纹&lt;/b&gt;（同 echostr 二次保存配置必须成功）。&#xD;
[xUnit.net 00:00:00.28]       /// &lt;/para&gt;&#xD;
[xUnit.net 00:00:00.28]       /// &lt;/remarks&gt;&#xD;
[xUnit.net 00:00:00.28]       public interface IMpCallbackReceiver&#xD;
[xUnit.net 00:00:00.28]       {&#xD;
[xUnit.net 00:00:00.28]           /// &lt;summary&gt;接收 POST 消息推送并解析为信封。&lt;/summary&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;param name="appKey"&gt;路由提取的应用键。&lt;/param&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;param name="urlQuery"&gt;回调 URL 查询串（可含前导 &lt;c&gt;?&lt;/c&gt;）。&lt;/param&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;param name="body"&gt;请求体原文（XML）。&lt;/param&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;param name="cancellationToken"&gt;取消令牌。&lt;/param&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;returns&gt;解密并解析后的信封。&lt;/returns&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;exception cref="WechatCallbackException"&gt;验签失败、时效越界、重放、解密失败或 appid 不匹配时抛出。&lt;/exception&gt;&#xD;
[xUnit.net 00:00:00.28]           Task&lt;MpCallbackEnvelope&gt; ReceiveAsync(&#xD;
[xUnit.net 00:00:00.28]               string appKey, string urlQuery, string body, CancellationToken cancellationToken = default);&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]           /// &lt;summary&gt;处理 GET URL 验证并返回应回写的明文（= &lt;c&gt;echostr&lt;/c&gt; 原文）。&lt;/summary&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;param name="appKey"&gt;路由提取的应用键。&lt;/param&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;param name="urlQuery"&gt;回调 URL 查询串。&lt;/param&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;param name="cancellationToken"&gt;取消令牌。&lt;/param&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;returns&gt;回写体（&lt;c&gt;echostr&lt;/c&gt; 原文）。&lt;/returns&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;exception cref="WechatCallbackException"&gt;验签失败、时效越界或 echostr 解密后的 appid 不匹配时抛出。&lt;/exception&gt;&#xD;
[xUnit.net 00:00:00.28]           Task&lt;string&gt; EchoAsync(string appKey, string urlQuery, CancellationToken cancellationToken = default);&#xD;
[xUnit.net 00:00:00.28]       }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]       /// &lt;inheritdoc cref="IMpCallbackReceiver" /&gt;&#xD;
[xUnit.net 00:00:00.28]       public sealed class MpCallbackReceiver : IMpCallbackReceiver&#xD;
[xUnit.net 00:00:00.28]       {&#xD;
[xUnit.net 00:00:00.28]           private readonly IOptionsMonitor&lt;MpCallbackOptions&gt; _optionsMonitor;&#xD;
[xUnit.net 00:00:00.28]           private readonly IWechatCallbackReplayGuard _replayGuard;&#xD;
[xUnit.net 00:00:00.28]           private readonly Func&lt;DateTimeOffset&gt; _utcNow;&#xD;
[xUnit.net 00:00:00.28]           private readonly ILogger&lt;MpCallbackReceiver&gt;? _logger;&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]           /// &lt;summary&gt;创建回调接收器。&lt;/summary&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;param name="optionsMonitor"&gt;回调配置监视器（请求期热更）。&lt;/param&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;param name="replayGuard"&gt;抗重放守卫（默认进程内实现）。&lt;/param&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;param name="utcNow"&gt;当前时间提供器（测试可注入）。&lt;/param&gt;&#xD;
[xUnit.net 00:00:00.28]           /// &lt;param name="logger"&gt;日志器。&lt;/param&gt;&#xD;
[xUnit.net 00:00:00.28]           public MpCallbackReceiver(&#xD;
[xUnit.net 00:00:00.28]               IOptionsMonitor&lt;MpCallbackOptions&gt; optionsMonitor,&#xD;
[xUnit.net 00:00:00.28]               IWechatCallbackReplayGuard replayGuard,&#xD;
[xUnit.net 00:00:00.28]               Func&lt;DateTimeOffset&gt;? utcNow = null,&#xD;
[xUnit.net 00:00:00.28]               ILogger&lt;MpCallbackReceiver&gt;? logger = null)&#xD;
[xUnit.net 00:00:00.28]           {&#xD;
[xUnit.net 00:00:00.28]               _optionsMonitor = optionsMonitor ?? throw new ArgumentNullException(nameof(optionsMonitor));&#xD;
[xUnit.net 00:00:00.28]               _replayGuard = replayGuard ?? throw new ArgumentNullException(nameof(replayGuard));&#xD;
[xUnit.net 00:00:00.28]               _utcNow = utcNow ?? (() =&gt; DateTimeOffset.UtcNow);&#xD;
[xUnit.net 00:00:00.28]               _logger = logger;&#xD;
[xUnit.net 00:00:00.28]           }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]           /// &lt;inheritdoc /&gt;&#xD;
[xUnit.net 00:00:00.28]           public async Task&lt;MpCallbackEnvelope&gt; ReceiveAsync(&#xD;
[xUnit.net 00:00:00.28]               string appKey, string urlQuery, string body, CancellationToken cancellationToken = default)&#xD;
[xUnit.net 00:00:00.28]           {&#xD;
[xUnit.net 00:00:00.28]               var options = _optionsMonitor.CurrentValue;&#xD;
[xUnit.net 00:00:00.28]               var app = ResolveApp(options, appKey);&#xD;
[xUnit.net 00:00:00.28]               var mode = app.ResolveMode(options.DefaultSecurityMode);&#xD;
[xUnit.net 00:00:00.28]               var query = WechatCallbackQuery.Parse(urlQuery);&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]               var timestamp = query.TryGetValue("timestamp", out var ts) ? ts : null;&#xD;
[xUnit.net 00:00:00.28]               var nonce = query.TryGetValue("nonce", out var n) ? n : null;&#xD;
[xUnit.net 00:00:00.28]               query.TryGetValue("msg_signature", out var msgSignature);&#xD;
[xUnit.net 00:00:00.28]               query.TryGetValue("signature", out var signature);&#xD;
[xUnit.net 00:00:00.28]               query.TryGetValue("encrypt_type", out var encryptType);&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]               var encrypt = ExtractEncrypt(body);&#xD;
[xUnit.net 00:00:00.28]               var isEncrypted = encrypt != null;&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]               string plaintext;&#xD;
[xUnit.net 00:00:00.28]               string fingerprint;&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]               if (isEncrypted)&#xD;
[xUnit.net 00:00:00.28]               {&#xD;
[xUnit.net 00:00:00.28]                   // —— 密文分支：4 参 msg_signature（**禁止**用 signature 验 POST）——&#xD;
[xUnit.net 00:00:00.28]                   if (string.IsNullOrEmpty(msgSignature))&#xD;
[xUnit.net 00:00:00.28]                   {&#xD;
[xUnit.net 00:00:00.28]                       throw new WechatCallbackException(&#xD;
[xUnit.net 00:00:00.28]                           WechatCallbackFailureKind.MissingSignature, "回调验签失败：缺少 msg_signature 参数。");&#xD;
[xUnit.net 00:00:00.28]                   }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]                   var expected = WechatCallbackCrypto.ComputeSignature(&#xD;
[xUnit.net 00:00:00.28]                       app.PushToken, timestamp ?? string.Empty, nonce ?? string.Empty, encrypt!);&#xD;
[xUnit.net 00:00:00.28]                   if (!FixedTimeEquals(expected, msgSignature!))&#xD;
[xUnit.net 00:00:00.28]                   {&#xD;
[xUnit.net 00:00:00.28]                       throw new WechatCallbackException(&#xD;
[xUnit.net 00:00:00.28]                           WechatCallbackFailureKind.InvalidSignature,&#xD;
[xUnit.net 00:00:00.28]                           "回调验签失败：msg_signature 不匹配（请检查 PushToken 配置）。");&#xD;
[xUnit.net 00:00:00.28]                   }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]                   ValidateTimestampWindow(options, timestamp);&#xD;
[xUnit.net 00:00:00.28]                   ValidateNonce(nonce);&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]                   plaintext = WechatCallbackCrypto.Decrypt(app.PushEncodingAESKey, encrypt!, out var receiveId);&#xD;
[xUnit.net 00:00:00.28]                   if (!string.Equals(receiveId, app.AppId, StringComparison.Ordinal))&#xD;
[xUnit.net 00:00:00.28]                   {&#xD;
[xUnit.net 00:00:00.28]                       throw new WechatCallbackException(&#xD;
[xUnit.net 00:00:00.28]                           WechatCallbackFailureKind.ReceiveIdMismatch,&#xD;
[xUnit.net 00:00:00.28]                           "回调验签失败：解密明文尾部的 appid 与配置 AppId 不一致（官方要求校验该值是否与自身公众号相符）。");&#xD;
[xUnit.net 00:00:00.28]                   }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]                   // P2-3：同一次 SHA1 结果先做验签比对，解密成功后再作为一次性指纹 —— 指纹取材于密文，密文缺失则不可得。&#xD;
[xUnit.net 00:00:00.28]                   fingerprint = expected;&#xD;
[xUnit.net 00:00:00.28]               }&#xD;
[xUnit.net 00:00:00.28]               else&#xD;
[xUnit.net 00:00:00.28]               {&#xD;
[xUnit.net 00:00:00.28]                   // —— 明文分支：安全模式一律拒收；明文/兼容模式用 3 参 signature 验签 ——&#xD;
[xUnit.net 00:00:00.28]                   if (mode == MpCallbackSecurityMode.Safe)&#xD;
[xUnit.net 00:00:00.28]                   {&#xD;
[xUnit.net 00:00:00.28]                       throw new WechatCallbackException(&#xD;
[xUnit.net 00:00:00.28]                           WechatCallbackFailureKind.PlainTextRejected,&#xD;
[xUnit.net 00:00:00.28]                           "回调拒收：当前公众号配置为安全模式（纯密文），明文推送一律拒绝。");&#xD;
[xUnit.net 00:00:00.28]                   }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]                   if (string.IsNullOrEmpty(signature))&#xD;
[xUnit.net 00:00:00.28]                   {&#xD;
[xUnit.net 00:00:00.28]                       throw new WechatCallbackException(&#xD;
[xUnit.net 00:00:00.28]                           WechatCallbackFailureKind.MissingSignature, "回调验签失败：缺少 signature 参数（明文模式）。");&#xD;
[xUnit.net 00:00:00.28]                   }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]                   var expected = WechatCallbackCrypto.ComputeSignature(&#xD;
[xUnit.net 00:00:00.28]                       app.PushToken, timestamp ?? string.Empty, nonce ?? string.Empty);&#xD;
[xUnit.net 00:00:00.28]                   if (!FixedTimeEquals(expected, signature!))&#xD;
[xUnit.net 00:00:00.28]                   {&#xD;
[xUnit.net 00:00:00.28]                       throw new WechatCallbackException(&#xD;
[xUnit.net 00:00:00.28]                           WechatCallbackFailureKind.InvalidSignature,&#xD;
[xUnit.net 00:00:00.28]                           "回调验签失败：signature 不匹配（请检查 PushToken 配置）。");&#xD;
[xUnit.net 00:00:00.28]                   }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]                   ValidateTimestampWindow(options, timestamp);&#xD;
[xUnit.net 00:00:00.28]                   ValidateNonce(nonce);&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]                   plaintext = body;&#xD;
[xUnit.net 00:00:00.28]                   // 明文模式无密文可取材：以「时效参数 + 明文包体」计算传输级摘要（非签名值，仅作一次性指纹）。&#xD;
[xUnit.net 00:00:00.28]                   fingerprint = WechatCallbackCrypto.ComputeSignature(&#xD;
[xUnit.net 00:00:00.28]                       string.Empty, timestamp ?? string.Empty, nonce ?? string.Empty, plaintext);&#xD;
[xUnit.net 00:00:00.28]               }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]               if (app.RequireReplayGuard)&#xD;
[xUnit.net 00:00:00.28]               {&#xD;
[xUnit.net 00:00:00.28]                   var window = TimeSpan.FromSeconds(options.AllowClockSkewSeconds);&#xD;
[xUnit.net 00:00:00.28]                   if (!await _replayGuard.TryMarkAsync(fingerprint, window, cancellationToken).ConfigureAwait(false))&#xD;
[xUnit.net 00:00:00.28]                   {&#xD;
[xUnit.net 00:00:00.28]                       throw new WechatCallbackException(&#xD;
[xUnit.net 00:00:00.28]                           WechatCallbackFailureKind.ReplaySuspected, "回调验签失败：报文已处理过（疑似重放）。");&#xD;
[xUnit.net 00:00:00.28]                   }&#xD;
[xUnit.net 00:00:00.28]               }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]               var envelope = new MpCallbackEnvelope&#xD;
[xUnit.net 00:00:00.28]               {&#xD;
[xUnit.net 00:00:00.28]                   AppKey = appKey,&#xD;
[xUnit.net 00:00:00.28]                   DecryptedXml = plaintext,&#xD;
[xUnit.net 00:00:00.28]                   TimeStamp = timestamp,&#xD;
[xUnit.net 00:00:00.28]                   Nonce = nonce,&#xD;
[xUnit.net 00:00:00.28]                   EncryptType = encryptType,&#xD;
[xUnit.net 00:00:00.28]                   SecurityMode = mode,&#xD;
[xUnit.net 00:00:00.28]                   IsEncrypted = isEncrypted,&#xD;
[xUnit.net 00:00:00.28]               };&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]               FillEnvelopeFields(envelope, plaintext);&#xD;
[xUnit.net 00:00:00.28]               return envelope;&#xD;
[xUnit.net 00:00:00.28]           }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]           /// &lt;inheritdoc /&gt;&#xD;
[xUnit.net 00:00:00.28]           public Task&lt;string&gt; EchoAsync(string appKey, string urlQuery, CancellationToken cancellationToken = default)&#xD;
[xUnit.net 00:00:00.28]           {&#xD;
[xUnit.net 00:00:00.28]               var options = _optionsMonitor.CurrentValue;&#xD;
[xUnit.net 00:00:00.28]               var app = ResolveApp(options, appKey);&#xD;
[xUnit.net 00:00:00.28]               var mode = app.ResolveMode(options.DefaultSecurityMode);&#xD;
[xUnit.net 00:00:00.28]               var query = WechatCallbackQuery.Parse(urlQuery);&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]               query.TryGetValue("signature", out var signature);&#xD;
[xUnit.net 00:00:00.28]               query.TryGetValue("timestamp", out var timestamp);&#xD;
[xUnit.net 00:00:00.28]               query.TryGetValue("nonce", out var nonce);&#xD;
[xUnit.net 00:00:00.28]               query.TryGetValue("echostr", out var echoStr);&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]               if (string.IsNullOrEmpty(signature))&#xD;
[xUnit.net 00:00:00.28]               {&#xD;
[xUnit.net 00:00:00.28]                   throw new WechatCallbackException(&#xD;
[xUnit.net 00:00:00.28]                       WechatCallbackFailureKind.MissingSignature, "URL 验证失败：缺少 signature 参数。");&#xD;
[xUnit.net 00:00:00.28]               }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]               if (string.IsNullOrEmpty(echoStr))&#xD;
[xUnit.net 00:00:00.28]               {&#xD;
[xUnit.net 00:00:00.28]                   throw new WechatCallbackException(&#xD;
[xUnit.net 00:00:00.28]                       WechatCallbackFailureKind.MissingEncrypt, "URL 验证失败：缺少 echostr 参数。");&#xD;
[xUnit.net 00:00:00.28]               }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]               // F3：URL 验证签名只含 token / timestamp / nonce（**不含** echostr）。&#xD;
[xUnit.net 00:00:00.28]               var expected = WechatCallbackCrypto.ComputeSignature(&#xD;
[xUnit.net 00:00:00.28]                   app.PushToken, timestamp ?? string.Empty, nonce ?? string.Empty);&#xD;
[xUnit.net 00:00:00.28]               if (!FixedTimeEquals(expected, signature!))&#xD;
[xUnit.net 00:00:00.28]               {&#xD;
[xUnit.net 00:00:00.28]                   throw new WechatCallbackException(&#xD;
[xUnit.net 00:00:00.28]                       WechatCallbackFailureKind.InvalidSignature, "URL 验证失败：signature 不匹配（请检查 PushToken 配置）。");&#xD;
[xUnit.net 00:00:00.28]               }&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]               ValidateTimestampWindow(options, timestamp);&#xD;
[xUnit.net 00:00:00.28]               // 幂等：GET 回显**不消费**指纹（平台会反复点「提交」，同 echostr 二次保存配置必须成功）。&#xD;
[xUnit.net 00:00:00.28]       &#xD;
[xUnit.net 00:00:00.28]               // 安全/兼容模式下 echostr 为密文：解密校验 appid（明文模式无解密环节，跳过 —— 见方案 R4）。&#xD;
[xUnit.net 00:00:00.28]               if (mode != MpCallbackSecurityMode.Plain)&#xD;
[xUnit.net 00:00:00.28]               {&#xD;
[xUnit.net 00:00:00.28]                   try&#xD;
[xUnit.net 00:00:00.28]                   {&#xD;
[xUnit.net 00:00:00.28]                       WechatCallbackCrypto.Decrypt(app.PushEncodingAESKey, echoStr!, out var receiveId);&#xD;
[xUnit.net 00:00:00.28]                       if (!string.Equals(receiveId, app.AppId, StringComparison.Ordinal))&#xD;
[xUnit.net 00:00:00.28]                       {&#xD;
[xUnit.net 00:00:00.28]                           throw new WechatCallbackException(&#xD;
[xUnit.net 00:00:00.28]                               WechatCallbackFailureKind.ReceiveIdMismatch,&#xD;
[xUnit.net 00:00:00.28]                               "URL 验证失败：echostr 解密出的 appid 与配置 AppId 不一致。");&#xD;
[xUnit.net 00:00:00.28]                       }&#xD;
[xUnit.net 00:00:00.28]                   }&#xD;
[xUnit.net 00:00:00.28]                   catch (WechatCallbackException ex) when (ex.Kind == WechatCallbackFailureKind.DecryptFailed)&#xD;
[xUnit.net 00:00:00.28]                   {&#xD;
[xUnit.net 00:00:00.28]                       // 兼容模式下平台可能以明文发送 echostr：此时无解密环节，跳过 appid 校验。&#xD;
[xUnit.net 00:00:00.28]                       _logger?.LogDebug("URL 验证的 echostr 非密文形态（兼容/明文模式），跳过 appid 校验。");&#xD;
[xUnit.net 00:00:00.28]                   }&#xD;
[xUnit.net 00:00:00.28]               }&#xD;
[xUnit.net 00:00:00.29]       &#xD;
[xUnit.net 00:00:00.29]               // F3：通过校验后「原样返回 echostr 参数内容」。&#xD;
[xUnit.net 00:00:00.29]               return Task.FromResult(echoStr!);&#xD;
[xUnit.net 00:00:00.29]           }&#xD;
[xUnit.net 00:00:00.29]       &#xD;
[xUnit.net 00:00:00.29]           private static MpAppCallbackOptions ResolveApp(MpCallbackOptions options, string appKey)&#xD;
[xUnit.net 00:00:00.29]               =&gt; options.ResolveApp(appKey)&#xD;
[xUnit.net 00:00:00.29]                  ?? throw new WechatCallbackException(&#xD;
[xUnit.net 00:00:00.29]                      WechatCallbackFailureKind.UnknownReceiver,&#xD;
[xUnit.net 00:00:00.29]                      $"回调配置未命中应用 \"{appKey}\"（既无精确键也无通配 \"{MpCallbackOptions.WildcardAppKey}\" 键）。");&#xD;
[xUnit.net 00:00:00.29]       &#xD;
[xUnit.net 00:00:00.29]           private void ValidateTimestampWindow(MpCallbackOptions options, string? timestamp)&#xD;
[xUnit.net 00:00:00.29]           {&#xD;
[xUnit.net 00:00:00.29]               if (string.IsNullOrEmpty(timestamp)&#xD;
[xUnit.net 00:00:00.29]                   || !long.TryParse(timestamp, NumberStyles.Integer, CultureInfo.InvariantCulture, out var ts))&#xD;
[xUnit.net 00:00:00.29]               {&#xD;
[xUnit.net 00:00:00.29]                   throw new WechatCallbackException(&#xD;
[xUnit.net 00:00:00.29]                       WechatCallbackFailureKind.MissingTimestamp, "回调验签失败：timestamp 缺失或非数字。");&#xD;
[xUnit.net 00:00:00.29]               }&#xD;
[xUnit.net 00:00:00.29]       &#xD;
