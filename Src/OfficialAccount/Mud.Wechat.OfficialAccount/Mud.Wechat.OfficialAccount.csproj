<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>微信公众号/服务号 SDK：认证与多应用基座（接口调用凭据签发、令牌管理器普通/稳定双通道、多公众号管理、配置面、常量/枚举/异常、回调信封与载荷契约）、官方 DTO（AOT 源生成 JsonContext）、业务声明式客户端、模块注册器、errcode 令牌失效判定器。一线一入口包（2026-10 包合并：原 Mud.Wechat.OfficialAccount.Abstractions / Mud.Wechat.OfficialAccount.DataModels 并入本包，命名空间不变；收推送另引 Mud.Wechat.OfficialAccount.Callback）。对应 Mud.Wechat.Work。</Description>
		<PackageTags>Wechat;OfficialAccount;公众号;服务号;SDK;Authentication;TokenManager;MultiApp;DTO;MudWechat</PackageTags>
		<!-- MUD005（Query 令牌注入存在 URL 泄露面）：微信公众号官方契约强制令牌走 Query 参数
		（access_token 为 URL 查询参数，官方不支持 Header 注入），无法改用 Header。
		本包全部接口均为该官方契约，属已知接受风险（详见各接口 remarks 与契约守卫测试），
		以 F6(b) 声明式 MSBuild 开关豁免（组件 3.0.5+，可审计）；库内遥测已由 SensitiveUrlRedactor 脱敏。
		旧的 SYSLIB1100/1101 抑制已删除：令牌恢复配置绑定改走"纯 DTO + Apply"两段式，不再产生该诊断。 -->
		<MudHttpSuppressQueryTokenInjection>true</MudHttpSuppressQueryTokenInjection>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils" Version="3.0.9" />
		<PackageReference Include="Mud.HttpUtils.Attributes" Version="3.0.9" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.9" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- 回调契约登记生成器（产品线中立工具，回调接收模块设计方案 v3 §3.4）：按 [MpCallbackContract] 声明
	     发射 MpPayloadContracts.RegisterAll 方法体。**必须挂在承载公众号载荷 DTO 的工程**：
	     partial 方法体与 partial 宿主必须同属一个程序集，而公众号载荷 DTO 与契约宿主落本包
	     （原 OA.Abstractions 面；2026-10 包合并后由本工程承载）。工具为中立名，不构成对 Work 产品线的横向引用。 -->
	<ItemGroup>
		<ProjectReference Include="..\..\Core\Mud.Wechat.Callback.Generator\Mud.Wechat.Callback.Generator.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<!-- 令牌基座与后台刷新需要 HttpClientFactory / Hosting 面（原 Abstractions 包携带，合并后由本包携带）。 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\Mud.Wechat.Abstractions\Mud.Wechat.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 回调载荷/信封的 internal set 由运行时包（读取器/接收器）与测试工程填写（与企微侧 Work.Callback 同款）。
		     生成上下文为 internal（对齐 Work 线 DataModels 模式），契约守卫与反序列化测试需直读。 -->
		<InternalsVisibleTo Include="Mud.Wechat.OfficialAccount.Tests" />
		<InternalsVisibleTo Include="Mud.Wechat.OfficialAccount.Callback" />
		<InternalsVisibleTo Include="Mud.Wechat.OfficialAccount.Callback.Tests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

</Project>
