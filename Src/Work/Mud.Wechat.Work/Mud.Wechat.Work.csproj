<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>企业微信 SDK：认证与多应用基座（令牌签发客户端、令牌管理器模板基座与四管理器、多应用管理、配置面、常量/枚举/异常）、官方 DTO（AOT 源生成 JsonContext）、业务声明式客户端、模块注册器、errcode 令牌失效判定器。一线一入口包（2026-10 包合并：原 Mud.Wechat.Work.Abstractions / Mud.Wechat.Work.DataModels 并入本包，命名空间不变；收推送另引 Mud.Wechat.Work.Callback）。对应 Mud.Feishu。</Description>
		<PackageTags>Wechat;WeChatWork;企业微信;SDK;Authentication;TokenManager;MultiApp;DTO;MudWechat</PackageTags>
		<MudHttpSuppressQueryTokenInjection>true</MudHttpSuppressQueryTokenInjection>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils" Version="3.0.9" />
		<PackageReference Include="Mud.HttpUtils.Attributes" Version="3.0.9" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.9" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- 令牌基座与后台刷新需要 HttpClientFactory / Hosting 面（原 Abstractions 包携带，合并后由本包携带）。 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- 响应基底实现公用层判错契约 IWechatApiResponse；令牌基座取公用层配置基座与 SSRF 白名单（叶层）。 -->
		<ProjectReference Include="..\..\Core\Mud.Wechat.Abstractions\Mud.Wechat.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 会话存档原生封装的实现细节（P/Invoke 声明、SafeHandle、分片聚合器）一律 internal：
		     原生契约不是公开面（宿主只经 IWechatWorkFinanceClientFactory 取用）。
		     契约守卫 FIN-B1/B3 与相应测试需直读，故开给测试工程。
		     回调包需直读令牌基座 internal 成员（合并前经 Abstractions 的 IVT，合并后落本包）。 -->
		<InternalsVisibleTo Include="Mud.Wechat.Work.Callback" />
		<InternalsVisibleTo Include="Mud.Wechat.Work.Tests" />
		<InternalsVisibleTo Include="Mud.Wechat.Work.Callback.Tests" />
		<InternalsVisibleTo Include="Mud.Wechat.Work.Abstractions.Tests" />
		<InternalsVisibleTo Include="Mud.Wechat.Work.DataModels.Tests" />
		<!-- AI 底座测试需要构造回调信封（AppKey 为 internal set —— 生产上由接收器写入）。 -->
		<InternalsVisibleTo Include="Mud.Wechat.Work.AI.Tests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

</Project>
