<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>Mud.Wechat.Work.OrgApprovalDemo</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- 前端产物随构建落位：门禁冒烟直接执行 bin 下的 dll，此时内容根是 bin 目录。 -->
		<Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<!-- 本机真值文件（**不提交**，.gitignore 的 **/appsettings.local.json 已覆盖）。
		     Web SDK 的默认复制规则只认 appsettings.json / appsettings.{Environment}.json，
		     不带 appsettings.local.json ⇒ 必须在这里显式落位，否则「设了设置链却读不到」
		     （配置链的基点钉在 AppContext.BaseDirectory）。
		     Condition 保证 fresh clone 没有该文件时构建照常通过。 -->
		<Content Update="appsettings.local.json"
		         CopyToOutputDirectory="PreserveNewest"
		         Condition="Exists('$(MSBuildProjectDirectory)\appsettings.local.json')" />
	</ItemGroup>

	<ItemGroup>
		<!-- Demo 基座：环境变量校验、写操作闸、健康检查端点、业务异常 → 502 映射闸。 -->
		<ProjectReference Include="..\Mud.Wechat.Demo.Shared\Mud.Wechat.Demo.Shared.csproj" />
		<!-- 企微主包：多应用底座 + 通讯录（Contact）与审批（Approval）两个模块。 -->
		<PackageReference Include="Mud.Wechat.Work" Version="$(MudWechatPackageVersion)" />
		<!-- 回调接收链路（验签 / AES 解密 / 事件分发 / 类型化处理器）。
		     回调处理器契约分析器（MUDCB002~005）随该包 analyzers/dotnet/cs 下发，无需单独引用；
		     本工程 8 个 handler 接入编译期校验，0 诊断为预期。 -->
		<PackageReference Include="Mud.Wechat.Work.Callback" Version="$(MudWechatPackageVersion)" />
	</ItemGroup>

	<ItemGroup>
		<!-- 本地台账层（方案 §0 / §5）：FreeSql + SQLite。Demos 已关 AOT/Trim，FreeSql 的
		     反射/表达式面可用；SDK 源工程不得引 FreeSql（AOT 红线），持久层只在 Demo 内。 -->
		<PackageReference Include="FreeSql.Provider.Sqlite" Version="3.5.311" />
	</ItemGroup>

</Project>
