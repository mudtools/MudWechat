<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>企业微信 SDK Redis 分布式存储扩展包：令牌持久层（含批量删除）、企业授权仓储、套件票据仓储与回调抗重放守卫的 Redis 实现，适用于多实例部署，支持 Native AOT 发布（net8.0+）。对应 Mud.Feishu.Redis。</Description>
		<PackageTags>Wechat;WeChatWork;企业微信;Redis;Distributed;TokenStore;MultiInstance;MudWechat</PackageTags>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.9" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="StackExchange.Redis" Version="3.4.5" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="StackExchange.Redis" Version="2.13.17" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils.Redis" Version="3.0.9" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Work\Mud.Wechat.Work\Mud.Wechat.Work.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Wechat.Redis.Tests" />
	</ItemGroup>

</Project>
